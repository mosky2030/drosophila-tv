<?xml version="1.0" encoding="utf-8"?>
<!-- Entering the puzzle game: the window comes up from black as Home fades out behind it.
     Paired with fade_out (the game leaving for Home) and with index.html's own curtain,
     which fades the board in from black once the WebView has drawn. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0.0"
    android:toAlpha="1.0"
    android:duration="220"
    android:interpolator="@android:interpolator/decelerate_quad" />
