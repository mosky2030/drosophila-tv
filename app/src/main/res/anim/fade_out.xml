<?xml version="1.0" encoding="utf-8"?>
<!-- The puzzle game leaving for Home: the window's surface goes, so the picture behind
     it shows through as it goes. Fading the views inside the window instead ran into the
     theme's black window background, and read as fade-to-black (PuzzleActivity.leave). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="1.0"
    android:toAlpha="0.0"
    android:duration="200"
    android:interpolator="@android:interpolator/decelerate_quad" />
